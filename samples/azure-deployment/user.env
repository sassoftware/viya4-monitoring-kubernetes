# Auto-generate StorageClass references for all PVCs
# Default: the AKS built-in managed-csi-premium (Premium SSD).
# Any existing StorageClass works, e.g. azuredisk-v4m from azuredisk-v4m.yaml.
# The deployment fails early if the StorageClass does not exist.
AUTOGENERATE_STORAGECLASS=true
STORAGECLASS=managed-csi-premium
#
# Optional per-component overrides (default: STORAGECLASS)
# PROMETHEUS_STORAGECLASS=
# ALERTMANAGER_STORAGECLASS=
# GRAFANA_STORAGECLASS=
# PUSHGATEWAY_STORAGECLASS=
# OPENSEARCH_STORAGECLASS=
