# This file contains IPv6-specific settings
# required by the log monitoring stack.
#
# Its contents are used to create a ConfigMap
# resource that defines environment variables
# surfaced on various pods and tweaking the
# pod's configuration to support IPv6-only
# clusters.


#OpenSearch
# NOTE: networkHost env var will *override*
# corresponding Helm chart value
network.bind_host=::
networkHost=::

#OpenSearch Dashboards
# NOTE: serverHost env var will *override*
# corresponding Helm chart value
#serverHost=::
SERVER_HOST=::

#Fluent Bit
FB_HTTP_LISTEN=::
