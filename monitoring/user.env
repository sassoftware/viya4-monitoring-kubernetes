# Configurable options for the monitoring scripts
# Use ENV_VAR=value or ENV_VAR="value"

# Global options
# --------------
# HELM_DEBUG=false
# LOG_DEBUG_ENABLE=false
# LOG_LEVEL_ENABLE=true
# LOG_COLOR_ENABLE=true

# deploy_monitoring_cluster.sh options
# ------------------------------------
# Cluster monitoring namespace for the Prometheus Operator,
# Grafana, dashboards, and cluster ServiceMonitors
# MON_NS=monitoring

# Enables tolerations and pod affinity to enable the monitoring
# components to participate in the SAS Viya workload node
# placement strategy
# MON_NODE_PLACEMENT_ENABLE=false

# Set to true to force an update of the Prometheus Operator CRDs
# PROM_OPERATOR_CRD_UPDATE=true

# The release of the Prometheus Operator CRDs to deploy
# if PROM_OPERATOR_CRD_UPDATE is true. This version should
# match the value of prometheusOperator.image.tag in the helm YAML
# if changed from the default.
# See https://github.com/prometheus-operator/prometheus-operator/releases
# PROM_OPERATOR_CRD_VERSION=v0.88.1

# Version of the kube-prometheus-stack helm chart to use
# KUBE_PROM_STACK_CHART_VERSION=81.5.2

# Additional Grafana datasources
# LOGGING_DATASOURCE=false

# Additional Grafana dashboards
# WELCOME_DASH=true
# KUBE_DASH=true
# VIYA_DASH=true
# PGMONITOR_DASH=true
# RABBITMQ_DASH=true
# NGINX_DASH=true
# LOGGING_DASH=true
# USER_DASH=true

# Deploys logging-enabled versions of the default dashboards for
# Java, Go, and CAS. Requires the logging datasource to be configured
# either manually or via the LOGGING_DATASOURCE user.env setting
# VIYA_LOGS_DASH=false

# Delivers the Grafana AI chatbot plugin (CHATBOT_PLUGIN_ID, default
# mainorg-joelmcpchat-app) into the running Grafana pod via
# monitoring/bin/deploy_ai_chatbot.sh. Run that script manually once first (it
# also provisions grafana-llm-app), with the grafana.* keys from
# monitoring/samples/ai-chatbot/user-values-prom-operator.yaml
# present in your user-values-prom-operator.yaml. See that sample file for the
# full prerequisite list.
# AI_CHATBOT_ENABLE=false

# AI chatbot: image/registry overrides
# ------------------------------------
# Full image reference for the custom-built v4m-mcp-server image. Override
# if you push it to your own registry rather than SAS's ACR.
# V4M_MCP_FULL_IMAGE="yourregistry.example.com/v4m-mcp-server:latest"

# Name of the imagePullSecret used to pull V4M_MCP_FULL_IMAGE. Set to an
# empty string if your registry needs no pull secret (e.g. a public registry).
# V4M_MCP_IMAGE_PULL_SECRET=acr-secret

# Full image reference for the Ollama embeddings server. Defaults to the
# public upstream image — override only if you need a private mirror.
# OLLAMA_FULL_IMAGE="docker.io/ollama/ollama:latest"

# Name of the imagePullSecret used to pull OLLAMA_FULL_IMAGE. Empty by
# default since the default image above is public; set this if you point
# OLLAMA_FULL_IMAGE at a private mirror.
# OLLAMA_IMAGE_PULL_SECRET=

# AI chatbot: Grafana access details (only needed if your cluster's
# defaults differ from the kube-prometheus-stack chart's conventions)
# -----------------------------------------------------------------
# Name of the Kubernetes Secret holding the Grafana admin password.
# Confirm yours with: kubectl get secret -n <namespace> | grep grafana
# GRAFANA_ADMIN_SECRET_NAME=v4m-grafana

# Scheme (http/https) Grafana serves internally inside the cluster.
# Defaults to https if TLS_ENABLE=true, http otherwise; override only if
# your cluster's internal scheme doesn't match its external TLS_ENABLE setting.
# GRAFANA_INTERNAL_SCHEME=https

# Plugin ID of the chatbot plugin (must match
# ai/chatbot-plugin/src/plugin.json's "id"). Only change this if you've
# forked/renamed the plugin.
# CHATBOT_PLUGIN_ID=mainorg-joelmcpchat-app

# Set PROM_NODEPORT_ENABLE=true to enable nodeport access
# to Prometheus and Alertmanager.
# Note that neither Prometheus nor Alertmanager provide
# authentication by default.
# PROM_NODEPORT_ENABLE=false

# Set this value to 'true' if using path-based ingress
# MON_TLS_PATH_INGRESS=true

# auto-generate access to web apps via Contour
# --------------------------------------
# AUTOGENERATE_INGRESS=true
# INGRESS_TYPE=contour
# ROUTING=host
#
# Set BASE_DOMAIN to allow correct the FQDN be generated for
# accessing the web applications (e.g. grafana.host.cluster.example.com)
# BASE_DOMAIN=host.cluster.example.com
#
# Note that neither Prometheus nor Alertmanager provide
# authentication by default and are not made accessible by default
# ALERTMANAGER_INGRESS_ENABLE=false
# PROMETHEUS_INGRESS_ENABLE=false
# GRAFANA_INGRESS_ENABLE=true

# deploy_monitoring_openshift.sh options
# --------------------------------------
# Used when OPENSHIFT_PATH_ROUTES=true
# Fully-qualified route hostname used for Grafana
# OPENSHIFT_ROUTE_HOST_GRAFANA=grafana.apps.my-openshift-cluster.com
# URL path where Grafana is available (used if OPENSHIFT_PATH_ROUTES=true)
# OPENSHIFT_ROUTE_PATH_GRAFANA=/grafana

## deploy_monitoring_viya.sh options
# ----------------------------------
# PUSHGATEWAY_ENABLED=true
# PUSHGATEWAY_CHART_VERSION=3.6.0
# VALIDATE_MONITORS=true


# IMPORTANT: SETTING PASSWORDS SECURELY
# ------------------------------------------
# Security best-practices discourage storing passwords in files.
# We have included setting passwords in this sample file
# only to illustrate the referenced environment variable.  
# You should set these environment variable via another, 
# more secure, mechanism.

# Set a specific password for the Grafana admin user
# Default is to generate a random password
# GRAFANA_ADMIN_PASSWORD=yourPasswordHere

# Azure OpenAI API key used by grafana-llm-app (powers the AI chatbot's LLM
# calls). Read by monitoring/bin/deploy_ai_chatbot.sh, which stores it in a
# Kubernetes Secret — it is not written into any ConfigMap.
# AZURE_OPENAI_API_KEY=yourAzureOpenAIKeyHere

# AI chatbot: Azure OpenAI configuration (powers grafana-llm-app)
# -----------------------------------------------------------------
# Your Azure OpenAI resource's classic endpoint (Azure Portal -> your
# resource -> Keys and Endpoint). Must be the resource-level endpoint, not
# an Azure AI Foundry project's Responses API endpoint.
# AZURE_OPENAI_URL=https://your-resource.openai.azure.com

# The deployment name you created for your model in that Azure OpenAI
# resource (Azure Portal -> your resource -> Model deployments).
# AZURE_OPENAI_DEPLOYMENT=yourDeploymentName
